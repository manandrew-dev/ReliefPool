# Copy to .env and fill in. .env is gitignored.

# Oracle service REST API (docs/api.md section 2)
VITE_ORACLE_URL=http://localhost:3001/api

# true: serve oracle responses from src/api/fixtures.ts. false: call VITE_ORACLE_URL.
VITE_ORACLE_MOCK=true

# ReliefPool program ID on devnet, once deployed
VITE_PROGRAM_ID=REPLACE_WITH_DEPLOYED_PROGRAM_ID
