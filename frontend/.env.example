# Copy to .env and fill in. .env is gitignored.

# Solana RPC endpoint. Must be a devnet endpoint: the wrong-network banner
# shows unless the hostname contains "devnet".
VITE_RPC_URL=https://api.devnet.solana.com

# Oracle service REST API (docs/api.md section 2)
VITE_ORACLE_URL=http://localhost:3001/api

# true: serve oracle responses from src/api/fixtures.ts and chain data from the
# matching mock chain. false: call VITE_ORACLE_URL and read the program on devnet.
VITE_ORACLE_MOCK=true

# ReliefPool program on devnet. Defaults to the address in idl/reliefpool.json.
VITE_PROGRAM_ID=7vBwrt8cAfrNHWNfCddQPRVdhbdKV8VhgP2xgq6qWsj3
