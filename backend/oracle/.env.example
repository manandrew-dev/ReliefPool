# Copy to .env and adjust. Every value has a default, so the service runs with no .env at all.

PORT=3001
# Comma-separated origins allowed to call the API (Vite dev server is 5173)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# USGS live feed
USGS_FEED_URL=https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/all_hour.geojson
POLL_INTERVAL_MS=30000
# In-region quakes below this are stored with riskScore 0 and never sent to the classifier
MIN_MAGNITUDE=5.0
# Set to false to switch off live polling (for example during a rehearsal)
POLL_ENABLED=true

# Classifier (Keith)
CLASSIFIER_URL=http://localhost:8000
# true = score with a local formula instead of calling the classifier
MOCK_CLASSIFIER=true

# Solana (Alice). MOCK_CHAIN=true fakes the program: threshold, payout and confirmation.
MOCK_CHAIN=true
MOCK_THRESHOLD=70
MOCK_PAYOUT_LAMPORTS=1000000000
MOCK_CONFIRM_MS=1000
RPC_URL=https://api.devnet.solana.com
ORACLE_KEYPAIR_PATH=./oracle-keypair.json
PROGRAM_ID=
POOL_ADDRESS=
VAULT_ADDRESS=

# Where events are persisted
DATA_FILE=./data/events.json
